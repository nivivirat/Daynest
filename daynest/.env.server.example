# Copy to .env.server. Never commit real credentials.
# Use your Neon DEVELOPMENT branch; keep sslmode=verify-full for certificate verification.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=verify-full
# Generate a random token with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the generated token here and enter it in Daynest settings at runtime.
API_TOKEN=
HOUSEHOLD_ID=personal
PORT=3001
# Use 0.0.0.0 only when testing from a phone on your trusted LAN.
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
